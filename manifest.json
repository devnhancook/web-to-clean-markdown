{
  "manifest_version": 3,
  "name": "Web to Clean Markdown for LLM",
  "version": "1.0.0",
  "description": "1-click convert any web article, documentation or page into clean, stripped Markdown for ChatGPT, Claude, Gemini and Obsidian.",
  "author": "devnhancook",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "clip-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "1-Click Clip Page to Clean Markdown"
    }
  }
}
